{
  "name": "@covsel/adapter-harness",
  "version": "0.2.0",
  "description": "covsel adapter for an external test harness, in any language, driving a Node application from outside — recorded from the app server's inspector",
  "license": "MIT",
  "author": "WAVIISoft, LLC",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@covsel/core": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/waviisoft/covsel.git",
    "directory": "packages/adapter-harness"
  },
  "keywords": [
    "test-impact-analysis",
    "coverage",
    "adapter",
    "harness"
  ],
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@covsel/conformance": "workspace:*"
  }
}
